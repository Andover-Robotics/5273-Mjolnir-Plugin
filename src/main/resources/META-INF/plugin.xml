<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.mjolnir5273.config</id>
    <name>Mjolnir Config Sync for FTC</name>
    <vendor email="arnav@andoverrobotics.com" url="https://www.andoverrobotics.com/">5273 ARC Thunder</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
    </extensions>
    <actions>
        <action id="com.mjolnir5273.config.ConfigVariableDeserializer.FTCDashboardAction" class="com.mjolnir5273.config.ConfigVariableDeserializer$FTCDashboardAction" text="Sync with Dashboard"
                description="Syncs your config variables with the variables in the current FTC Dashboard instance">
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="ToolsBasicGroup"/>
        </action>
    </actions>
</idea-plugin>
